<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_navigation_height"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@id/nav_passwords"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/nav_passwords"
            android:gravity="center"
            android:text="@string/nav_passwords"
            android:textSize="14sp" />

        <TextView
            android:id="@id/nav_taxonomy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/nav_taxonomy"
            android:gravity="center"
            android:text="@string/nav_taxonomy"
            android:textSize="14sp" />

        <TextView
            android:id="@id/nav_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/nav_more"
            android:gravity="center"
            android:text="@string/nav_more"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
